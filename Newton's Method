def newton(f, df, x0, tol=1e-10, max_iter=50):
    x = x0
    for _ in range(max_iter):
        x_new = x - f(x)/df(x)
        if abs(x_new - x) < tol:
            return x_new
        x = x_new
    return x


if __name__ == "__main__":
    f  = lambda x: x**3 - x - 1
    df = lambda x: 3*x**2 - 1
    root = newton(f, df, 1.5)
