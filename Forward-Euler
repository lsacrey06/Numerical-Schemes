import numpy as np

def forward_euler(f, t0, y0, h, N):
    t = np.zeros(N+1)
    y = np.zeros(N+1)

    t[0] = t0
    y[0] = y0

    for n in range(N):
        t[n+1] = t[n] + h
        y[n+1] = y[n] + h * f(t[n], y[n])

    return t, y


if __name__ == "__main__":
    f = lambda t, y: -y
    t, y = forward_euler(f, 0.0, 1.0, 0.1, 50)
