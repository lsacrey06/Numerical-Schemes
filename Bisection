def bisection(f, a, b, tol=1e-10, max_iter=100):
    if f(a)*f(b) > 0:
        raise ValueError("Root not bracketed")

    for _ in range(max_iter):
        c = 0.5*(a + b)
        if abs(f(c)) < tol:
            return c

        if f(a)*f(c) < 0:
            b = c
        else:
            a = c

    return 0.5*(a + b)


if __name__ == "__main__":
    f = lambda x: x**3 - x - 1
    root = bisection(f, 1, 2)
