import numpy as np

def rk4(f, t0, y0, h, N):
    t = np.zeros(N+1)
    y = np.zeros(N+1)

    t[0] = t0
    y[0] = y0

    for n in range(N):
        k1 = f(t[n], y[n])
        k2 = f(t[n] + h/2, y[n] + h*k1/2)
        k3 = f(t[n] + h/2, y[n] + h*k2/2)
        k4 = f(t[n] + h,   y[n] + h*k3)

        t[n+1] = t[n] + h
        y[n+1] = y[n] + (h/6)*(k1 + 2*k2 + 2*k3 + k4)

    return t, y


if __name__ == "__main__":
    f = lambda t, y: -y
    t, y = rk4(f, 0.0, 1.0, 0.1, 50)
