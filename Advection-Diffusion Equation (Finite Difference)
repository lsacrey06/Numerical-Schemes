import numpy as np

def advection_diffusion(u0, c, D, dx, dt, Nt):
    u = u0.copy()
    Nx = len(u0)

    for _ in range(Nt):
        u_new = u.copy()
        for i in range(1, Nx-1):
            u_new[i] = (
                u[i]
                - c*dt*(u[i] - u[i-1])/dx
                + D*dt*(u[i+1] - 2*u[i] + u[i-1])/dx**2
            )
        u = u_new

    return u
