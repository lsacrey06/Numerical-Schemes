import numpy as np

def lagrange(x, xs, ys):
    P = 0.0
    n = len(xs)

    for i in range(n):
        Li = 1.0
        for j in range(n):
            if i != j:
                Li *= (x - xs[j])/(xs[i] - xs[j])
        P += ys[i]*Li

    return P


if __name__ == "__main__":
    xs = np.array([0, 1, 2])
    ys = np.array([1, 2, 0])
    print(lagrange(1.5, xs, ys))
